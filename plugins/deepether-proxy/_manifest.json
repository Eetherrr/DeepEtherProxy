{
  "manifest_version": 2,
  "id": "com.ether.deepether-proxy",
  "version": "0.5.0",
  "name": "DeepEther Proxy",
  "description": "把 DeepSeek 网页版与 CommandCode Go 接入 MaiBot 的 LLM Provider",
  "author": {
    "name": "EtherTool",
    "url": "https://github.com/EtherTool/DeepEtherProxy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/EtherTool/DeepEtherProxy",
    "homepage": "https://github.com/EtherTool/DeepEtherProxy"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "999.999.999"
  },
  "plugin_type": "provider",
  "capabilities": [
    "send.text"
  ],
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27"
    },
    {
      "type": "python_package",
      "name": "wasmtime",
      "version_spec": ">=20"
    },
    {
      "type": "python_package",
      "name": "deepseek-pow",
      "version_spec": ">=0.0.1"
    },
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.12"
    }
  ],
  "llm_providers": [
    {
      "client_type": "com.ether.deepether",
      "name": "DeepEther Proxy",
      "description": "DeepSeek 网页版反代 Provider",
      "version": "0.5.0"
    },
    {
      "client_type": "com.ether.commandcode",
      "name": "CommandCode（Go 套餐）",
      "description": "CommandCode Go 订阅反代 Provider（/alpha/generate）",
      "version": "0.5.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "globe",
      "fallback": "puzzle",
      "background": "#1C272C"
    }
  }
}
